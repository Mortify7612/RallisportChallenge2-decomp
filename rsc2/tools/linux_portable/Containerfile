# Build image for the portable Linux release (see build.sh next to this file).
# Ubuntu 22.04 has glibc 2.35, so what it builds runs on Ubuntu 22.04,
# Linux Mint 21, Debian 12, a current SteamOS and anything newer.
#
# The compiler is GCC 15 from the Ubuntu toolchain PPA (its gcc-16 is a trunk
# snapshot), not 22.04's GCC 11:
# the generated game code ran 15-25% slower built with GCC 11.
FROM docker.io/library/ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        software-properties-common gpg-agent \
    && add-apt-repository -y ppa:ubuntu-toolchain-r/test \
    && apt-get update && apt-get install -y --no-install-recommends \
        gcc-15 g++-15 make cmake ninja-build python3 pkg-config ca-certificates \
        libsdl2-dev libepoxy-dev libvulkan1 \
    && rm -rf /var/lib/apt/lists/*
ENV CC=gcc-15 CXX=g++-15
